          "content": [
            {
              "type": "Heading",
              "props": {
                "id": "terms-heading-3",
                "text": "Terms",
                "level": "h1",
                "align": "left",
                "size": "display",
                "eyebrow": ""
              }
            },
            {
              "type": "Text",
              "props": {
                "id": "terms-text-4",
                "text": {
                  "rich": 1,
                  "blocks": [
                    {
                      "type": "p",
                      "children": [
                        {
                          "text": "These terms apply when you buy a template from this store."
                        }
                      ]
                    }
                  ]
                },
                "align": "left",
                "tone": "default"
              }
            },
            {
              "type": "Heading",
              "props": {
                "id": "terms-heading-5",
                "text": "Who you're buying from",
                "level": "h2",
                "align": "left",
                "size": "normal",
                "eyebrow": ""
              }
            },
            {
              "type": "Text",
              "props": {
                "id": "terms-text-6",
                "text": {
                  "rich": 1,
                  "blocks": [
                    {
                      "type": "p",
                      "children": [
                        {
                          "text": "Templates are made by the maker of Crust. Polar handles the payment and sells the templates on our behalf as the merchant of record. Polar adds tax where it applies and sends your receipt, and its buyer terms cover the payment itself."
                        }
                      ]
                    }
                  ]
                },
                "align": "left",
                "tone": "default"
              }
            },
            {
              "type": "Heading",
              "props": {
                "id": "terms-heading-7",
                "text": "What you get",
                "level": "h2",
                "align": "left",
                "size": "normal",
                "eyebrow": ""
              }
            },
            {
              "type": "Text",
              "props": {
                "id": "terms-text-8",
                "text": {
                  "rich": 1,
                  "blocks": [
                    {
                      "type": "p",
                      "children": [
                        {
                          "text": "A template file to open in Crust, the free app, and a personal download page. Updates to the template are free and appear on the same page. What you may do with the template is in the "
                        },
                        {
                          "text": "licence",
                          "href": "/licence"
                        },
                        {
                          "text": "."
                        }
                      ]
                    }
                  ]
                },
                "align": "left",
                "tone": "default"
              }
            },
            {
              "type": "Heading",
              "props": {
                "id": "terms-heading-9",
                "text": "If something is wrong",
                "level": "h2",
                "align": "left",
                "size": "normal",
                "eyebrow": ""
              }
            },
            {
              "type": "Text",
              "props": {
                "id": "terms-text-10",
                "text": {
                  "rich": 1,
                  "blocks": [
                    {
                      "type": "p",
                      "children": [
                        {
                          "text": "If a template doesn't open or doesn't match its store page, tell us and we'll fix it or refund you, even after the "
                        },
                        {
                          "text": "14-day refund window",
                          "href": "/refunds"
                        },
                        {
                          "text": ". Beyond that, templates come as they are, and we're not liable for more than you paid."
                        }
                      ]
                    }
                  ]
                },
                "align": "left",
                "tone": "default"
              }
            },
            {
              "type": "Heading",
              "props": {
                "id": "terms-heading-11",
                "text": "Changes and questions",
                "level": "h2",
                "align": "left",
                "size": "normal",
                "eyebrow": ""
              }
            },
            {
              "type": "Text",
              "props": {
                "id": "terms-text-12",
                "text": {
                  "rich": 1,
                  "blocks": [
                    {
                      "type": "p",
                      "children": [
                        {
                          "text": "If these terms change, the new version applies to purchases made after the change. Questions: "
                        },
                        {
                          "text": "reply to your receipt email"
                        },
                        {
                          "text": "."
                        }
                      ]
                    }
                  ]
                },
                "align": "left",
                "tone": "default"
              }
            }
          ]
        }
      }
    ]
