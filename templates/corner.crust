{"format":"crust-template","version":1,"name":"Corner","description":"Warm and local, for bakeries, cafés, shops and makers: a menu with prices, workshops, opening hours and ordering ahead. Young Serif, navy on cream.","exportedAt":"2026-11-03T00:00:00.000Z","site":{"name":"Corner Workshop","language":"en"},"tokens":{"colors":{"background":"#FBF4E4","surface":"#F3E7CC","text":"#1F2340","muted":"#575A70","primary":"#1F2340","onPrimary":"#FBF4E4"},"fonts":{"heading":"'Young Serif', Georgia, 'Times New Roman', serif","body":"'Work Sans', system-ui, -apple-system, 'Segoe UI', sans-serif"},"spacing":{"none":0,"xs":0.5,"sm":1,"md":2,"lg":4,"xl":6},"radius":10,"maxWidth":1120,"style":{"typeScale":"bold","headingWeight":400,"headingTracking":"snug","buttonShape":"pill","cardStyle":"flat","linkStyle":"underline","displayWeight":400,"displayTracking":"tight","labelStyle":"caps","motion":"subtle"},"sectionStyles":{"background":{"bg":"background","button":"solid"},"surface":{"bg":"surface","button":"solid"},"primary":{"bg":"primary","button":"inverse"},"dark":{"bg":"text","button":"inverse"}}},"header":{"show":true,"logo":{"text":"Corner Workshop","imageSrc":"","imageAlt":""},"menu":[{"label":"Menu","href":"/menu"},{"label":"Workshops","href":"/workshops"},{"label":"Our story","href":"/about"},{"label":"News","href":"/blog"},{"label":"Visit us","href":"/visit"}],"cta":{"label":"","href":""},"sticky":false,"style":"background","layout":"stacked","topBar":{"show":true,"text":"Fresh bread from 7:00, Tuesday to Sunday.","link":{"label":"Today's menu","href":"/menu"},"contact":"+353 1 555 0187","style":"primary"}},"footer":{"show":true,"text":"Bakery, coffee bar and Saturday workshop at 14 Mill Lane, Dublin 8.","columns":[{"title":"The shop","links":[{"label":"Menu","href":"/menu"},{"label":"Workshops","href":"/workshops"},{"label":"Order ahead","href":"/visit"}]},{"title":"Visit","links":[{"label":"Opening hours","href":"/visit"},{"label":"Our story","href":"/about"},{"label":"News","href":"/blog"}]}],"copyright":"© {year} {name}","style":"primary"},"pages":[{"path":"/","title":"Home","description":"Corner Workshop on Mill Lane: sourdough baked before seven, coffee roasted three streets away, and Saturday workshops in the back room.","puck":{"root":{"props":{}},"content":[{"type":"Section","props":{"id":"home-section-9","background":"surface","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"home-columns-8","count":"2","gap":"xl","column1":[{"type":"Heading","props":{"id":"home-heading-1","text":"Made by hand, around the corner","level":"h1","align":"left","size":"display","eyebrow":"Bakery · Coffee · Workshop","placeholder":["text","eyebrow"]}},{"type":"Text","props":{"id":"home-text-2","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Sourdough out of the oven before seven, coffee roasted three streets away, and a back room where you can learn to make things yourself."}]}]},"align":"left","tone":"muted","placeholder":["text"]}},{"type":"Spacer","props":{"id":"home-spacer-3","size":"xs"}},{"type":"Columns","props":{"id":"home-columns-6","count":"2","gap":"sm","column1":[{"type":"Button","props":{"id":"home-button-4","label":"See today's menu","href":"/menu","variant":"primary","align":"left"}}],"column2":[{"type":"Button","props":{"id":"home-button-5","label":"Find us","href":"/visit","variant":"arrow","align":"left"}}],"column3":[],"column4":[],"widths":{"desktop":"equal","tablet":"equal","phone":"stack"},"valign":"middle"}}],"column2":[{"type":"Image","props":{"id":"home-image-7","src":"/media/bread-hands.jpg","alt":"Two hands holding a round loaf of bread in a linen cloth","caption":"","placeholder":["src"]}}],"column3":[],"column4":[],"widths":{"desktop":"equal","tablet":"equal","phone":"stack"},"valign":"middle"}}]}},{"type":"Section","props":{"id":"home-section-22","background":"background","paddingY":"lg","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Heading","props":{"id":"home-heading-10","text":"Why the queue starts at seven","level":"h2","align":"left","size":"normal","eyebrow":""}},{"type":"Spacer","props":{"id":"home-spacer-11","size":"xs"}},{"type":"Columns","props":{"id":"home-columns-21","count":"3","gap":"xl","column1":[{"type":"Icon","props":{"id":"home-icon-12","icon":"wheat","look":"circle","size":"md","colour":"primary","label":"","href":"","align":"left"}},{"type":"Heading","props":{"id":"home-heading-13","text":"Baked before 7:00","level":"h3","align":"left","size":"normal","eyebrow":"","placeholder":["text"]}},{"type":"Text","props":{"id":"home-text-14","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Every loaf is shaped the night before and baked in the morning, six days a week."}]}]},"align":"left","tone":"muted","placeholder":["text"]}}],"column2":[{"type":"Icon","props":{"id":"home-icon-15","icon":"coffee","look":"circle","size":"md","colour":"primary","label":"","href":"","align":"left"}},{"type":"Heading","props":{"id":"home-heading-16","text":"Coffee from nearby","level":"h3","align":"left","size":"normal","eyebrow":"","placeholder":["text"]}},{"type":"Text","props":{"id":"home-text-17","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Beans roasted on Dock Street, three streets away, and ground to order."}]}]},"align":"left","tone":"muted","placeholder":["text"]}}],"column3":[{"type":"Icon","props":{"id":"home-icon-18","icon":"hammer","look":"circle","size":"md","colour":"primary","label":"","href":"","align":"left"}},{"type":"Heading","props":{"id":"home-heading-19","text":"Saturday workshops","level":"h3","align":"left","size":"normal","eyebrow":"","placeholder":["text"]}},{"type":"Text","props":{"id":"home-text-20","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Clay, wood and bread in the back room, for eight people at a time."}]}]},"align":"left","tone":"muted","placeholder":["text"]}}],"column4":[],"widths":{"desktop":"equal","tablet":"wrap","phone":"stack"}}}]}},{"type":"Section","props":{"id":"home-section-27","background":"background","paddingY":"lg","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"home-columns-25","count":"2","gap":"sm","column1":[{"type":"Heading","props":{"id":"home-heading-23","text":"On the counter this week","level":"h2","align":"left","size":"normal","eyebrow":""}}],"column2":[{"type":"Text","props":{"id":"home-text-24","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"The full menu","href":"/menu"}]}]},"align":"right","tone":"default"}}],"column3":[],"column4":[],"widths":{"desktop":"two-one","tablet":"two-one","phone":"stack"},"valign":"bottom"}},{"type":"Grid","props":{"id":"home-grid-26","columns":"3","titleLevel":"h3","background":"surface","items":[{"title":"Country sourdough","text":"Forty-eight hours from flour to loaf. €6.50","imageSrc":"/media/loaves.jpg","imageAlt":"Dark-crusted sourdough loaves beside a vase of yellow flowers","linkLabel":"","linkHref":""},{"title":"Breakfast for two","text":"A pot of coffee, two croissants and jam. €14","imageSrc":"/media/moka-breakfast.jpg","imageAlt":"A moka pot, croissants and a bag of coffee on a wooden table, seen from above","linkLabel":"","linkHref":""},{"title":"Lemon and lavender loaf","text":"Iced while warm, sold by the slice. €3.80","imageSrc":"/media/lemon-loaf.jpg","imageAlt":"An iced lemon and lavender loaf on a cooling rack, with lemons beside it","linkLabel":"","linkHref":""}],"placeholder":["items"]}}]}},{"type":"Section","props":{"id":"home-section-33","background":"surface","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"home-columns-32","count":"2","gap":"xl","column1":[{"type":"Image","props":{"id":"home-image-28","src":"/media/pouring-coffee.jpg","alt":"Coffee poured from a small jug into a white cup on a worn wooden counter","caption":"","placeholder":["src"]}}],"column2":[{"type":"Heading","props":{"id":"home-heading-29","text":"Everything is made here, in small batches, by the people who serve you.","level":"h2","align":"left","size":"normal","eyebrow":"Our story","placeholder":["text","eyebrow"]}},{"type":"Text","props":{"id":"home-text-30","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Corner opened in 2017 in a bakery that had been empty for ten years. The oven was still there. We cleaned it, fired it, and haven't let it go cold since."}]}]},"align":"left","tone":"muted","placeholder":["text"]}},{"type":"Text","props":{"id":"home-text-31","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Read our story","href":"/about"}]}]},"align":"left","tone":"default"}}],"column3":[],"column4":[],"widths":{"desktop":"one-two","tablet":"one-two","phone":"stack"},"valign":"middle"}}]}},{"type":"Section","props":{"id":"home-section-38","background":"background","paddingY":"lg","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"home-columns-36","count":"2","gap":"sm","column1":[{"type":"Heading","props":{"id":"home-heading-34","text":"Saturday workshops","level":"h2","align":"left","size":"normal","eyebrow":""}}],"column2":[{"type":"Text","props":{"id":"home-text-35","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Dates and prices","href":"/workshops"}]}]},"align":"right","tone":"default"}}],"column3":[],"column4":[],"widths":{"desktop":"two-one","tablet":"two-one","phone":"stack"},"valign":"bottom"}},{"type":"CardSlider","props":{"id":"home-cardslider-37","name":"Saturday workshops","items":[{"title":"Pottery morning","text":"Three hours at the wheel. You take home two pieces once they're fired. €65","imageSrc":"/media/pottery-wheel.jpg","imageAlt":"Hands shaping wet clay on a turning pottery wheel, seen from above","linkLabel":"Book a place","linkHref":"/workshops"},{"title":"Glaze and fire","text":"Glaze the pieces you've made, then watch the kiln being loaded. €80","imageSrc":"/media/ceramic-bottles.jpg","imageAlt":"Rows of glazed ceramic bottles in sage green and pale blue","linkLabel":"Book a place","linkHref":"/workshops"},{"title":"Woodwork weekend","text":"Two days with hand tools only. You leave with a stool you made yourself. €180","imageSrc":"/media/tool-wall.jpg","imageAlt":"A workshop wall of chisels, saws and hand planes in neat rows","linkLabel":"Book a place","linkHref":"/workshops"},{"title":"Sourdough class","text":"Mix, shape and bake. You take home a loaf and a jar of our starter. €55","imageSrc":"/media/bread-hands.jpg","imageAlt":"Two hands holding a round loaf of bread in a linen cloth","linkLabel":"Book a place","linkHref":"/workshops"}],"visible":"3","titleLevel":"h3","background":"surface","placeholder":["items"]}}]}},{"type":"Section","props":{"id":"home-section-40","background":"primary","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","width":"narrow","content":[{"type":"Quote","props":{"id":"home-quote-39","text":"The best loaf in the neighbourhood, and the kindest people serving it. I came for bread and stayed for the pottery.","name":"Tomás Byrne","role":"A regular since 2019","imageSrc":"","align":"center","size":"large","placeholder":["text","name","role"]}}]}},{"type":"Section","props":{"id":"home-section-47","background":"background","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"home-columns-46","count":"2","gap":"xl","column1":[{"type":"Heading","props":{"id":"home-heading-41","text":"Find us on Mill Lane","level":"h2","align":"left","size":"normal","eyebrow":"Visit","placeholder":["text","eyebrow"]}},{"type":"Text","props":{"id":"home-text-42","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Next to the flower stall, five minutes from the canal. There's a bench outside and a dog bowl by the door."}]}]},"align":"left","tone":"muted","placeholder":["text"]}},{"type":"Table","props":{"id":"home-table-43","caption":"Opening hours","rows":[["Day","Open"],["Tuesday to Friday","7:00 to 17:00"],["Saturday","8:00 to 16:00"],["Sunday","8:00 to 13:00"],["Monday","Closed"]],"headers":"both","look":"lines","placeholder":["caption","rows"]}},{"type":"Text","props":{"id":"home-text-44","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"How to get here","href":"/visit"}]}]},"align":"left","tone":"default"}}],"column2":[{"type":"Image","props":{"id":"home-image-45","src":"/media/flower-shop.jpg","alt":"A small flower shop front with buckets of flowers and wooden crates on the pavement","caption":"","placeholder":["src"]}}],"column3":[],"column4":[],"widths":{"desktop":"equal","tablet":"equal","phone":"stack"},"valign":"middle"}}]}},{"type":"LinkedSection","props":{"id":"home-linkedsection-48","section":"contact-strip"}}]}},{"path":"/menu","title":"Menu","description":"Bread, pastry, coffee and breakfast at Corner Workshop, with this week's prices.","puck":{"root":{"props":{}},"content":[{"type":"Section","props":{"id":"menu-section-3","background":"surface","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","width":"narrow","content":[{"type":"Heading","props":{"id":"menu-heading-1","text":"Baked this morning","level":"h1","align":"left","size":"display","eyebrow":"Menu","placeholder":["text","eyebrow"]}},{"type":"Text","props":{"id":"menu-text-2","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"What's on the counter changes with the season and sells out by early afternoon. Ask us about allergens: we know what's in everything, because we made it."}]}]},"align":"left","tone":"muted","placeholder":["text"]}}]}},{"type":"Section","props":{"id":"menu-section-11","background":"background","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"menu-columns-6","count":"2","gap":"xl","column1":[{"type":"Table","props":{"id":"menu-table-4","caption":"Bread","rows":[["Loaf","Price"],["Country sourdough","€6.50"],["Seeded rye","€5.80"],["Spelt and honey","€6.20"],["Baguette","€3.20"]],"headers":"top","look":"lines","placeholder":["caption","rows"]}}],"column2":[{"type":"Table","props":{"id":"menu-table-5","caption":"Pastry and cake","rows":[["Pastry","Price"],["Butter croissant","€2.80"],["Cardamom bun","€3.40"],["Lemon and lavender loaf, a slice","€3.80"],["Brown butter cookie","€2.50"]],"headers":"top","look":"lines","placeholder":["caption","rows"]}}],"column3":[],"column4":[],"widths":{"desktop":"equal","tablet":"equal","phone":"stack"}}},{"type":"Spacer","props":{"id":"menu-spacer-7","size":"md"}},{"type":"Columns","props":{"id":"menu-columns-10","count":"2","gap":"xl","column1":[{"type":"Table","props":{"id":"menu-table-8","caption":"Coffee","rows":[["Drink","Price"],["Espresso","€2.60"],["Flat white","€3.60"],["Filter, refilled once","€3.20"],["Moka pot for two","€6.00"]],"headers":"top","look":"lines","placeholder":["caption","rows"]}}],"column2":[{"type":"Table","props":{"id":"menu-table-9","caption":"Breakfast, until 11:30","rows":[["Plate","Price"],["Toast, butter and jam","€5.50"],["Breakfast for two","€14.00"],["Eggs on sourdough","€9.50"],["Yoghurt, fruit and granola","€7.00"]],"headers":"top","look":"lines","placeholder":["caption","rows"]}}],"column3":[],"column4":[],"widths":{"desktop":"equal","tablet":"equal","phone":"stack"}}}]}},{"type":"Section","props":{"id":"menu-section-13","background":"surface","paddingY":"lg","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Gallery","props":{"id":"menu-gallery-12","columns":"4","shape":"square","lightbox":"yes","images":[{"src":"/media/loaves.jpg","alt":"Dark-crusted sourdough loaves beside a vase of yellow flowers","caption":"Country sourdough"},{"src":"/media/moka-breakfast.jpg","alt":"A moka pot, croissants and a bag of coffee on a wooden table, seen from above","caption":"Breakfast for two"},{"src":"/media/lemon-loaf.jpg","alt":"An iced lemon and lavender loaf on a cooling rack, with lemons beside it","caption":"Lemon and lavender loaf"},{"src":"/media/moka-pour.jpg","alt":"Coffee pouring from a moka pot into a blue-striped cup","caption":"Moka pot for two"}],"placeholder":["images"]}}]}},{"type":"LinkedSection","props":{"id":"menu-linkedsection-14","section":"contact-strip"}}]}},{"path":"/workshops","title":"Workshops","description":"Pottery, woodwork and bread workshops on Saturdays at Corner Workshop: what you'll make, what it costs and how to book.","puck":{"root":{"props":{}},"content":[{"type":"Section","props":{"id":"workshops-section-3","background":"dark","paddingY":"lg","height":"large","valign":"bottom","imageSrc":"/media/pottery-wheel.jpg","tint":"strong","bgKind":"photo","placeholder":["imageSrc"],"content":[{"type":"Heading","props":{"id":"workshops-heading-1","text":"Learn to make it yourself","level":"h1","align":"left","size":"display","eyebrow":"Saturday workshops","placeholder":["text","eyebrow"]}},{"type":"Text","props":{"id":"workshops-text-2","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Pottery, woodwork and bread in the back room, for eight people at a time. No experience needed, and coffee is included."}]}]},"align":"left","tone":"default","placeholder":["text"]}}]}},{"type":"Section","props":{"id":"workshops-section-8","background":"background","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","anchor":"prices","content":[{"type":"Heading","props":{"id":"workshops-heading-4","text":"Choose a workshop","level":"h2","align":"center","size":"normal","eyebrow":""}},{"type":"Text","props":{"id":"workshops-text-5","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"All materials, tools, coffee and a pastry are included. Book at the counter or by email."}]}]},"align":"center","tone":"muted","placeholder":["text"]}},{"type":"Spacer","props":{"id":"workshops-spacer-6","size":"sm"}},{"type":"Pricing","props":{"id":"workshops-pricing-7","plans":[{"name":"Pottery morning","price":"€65","period":"3 hours","description":"Throw your first pots at the wheel.","features":"Two pieces, fired and posted to you\nAprons and tools\nCoffee and a pastry","buttonLabel":"Book pottery","buttonHref":"mailto:hello@corner.example"},{"name":"Sourdough class","price":"€55","period":"3 hours","description":"Mix, shape and bake a loaf.","features":"A loaf to take home\nA jar of our starter\nThe recipe we use","buttonLabel":"Book bread","buttonHref":"mailto:hello@corner.example"},{"name":"Glaze and fire","price":"€80","period":"4 hours","description":"Glaze pieces from a pottery morning.","features":"Glazes and firing\nA look inside the kiln\nLunch from the counter","buttonLabel":"Book glazing","buttonHref":"mailto:hello@corner.example"},{"name":"Woodwork weekend","price":"€180","period":"2 days","description":"Make a stool with hand tools only.","features":"Oak and all tools\nA stool to take home\nLunch both days","buttonLabel":"Book woodwork","buttonHref":"mailto:hello@corner.example"}],"highlight":"1","badge":"Most booked","planStyle":"surface","highlightStyle":"primary","titleLevel":"h3","placeholder":["plans"]}}]}},{"type":"Section","props":{"id":"workshops-section-13","background":"surface","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"workshops-columns-12","count":"2","gap":"xl","column1":[{"type":"Heading","props":{"id":"workshops-heading-9","text":"How a Saturday goes","level":"h2","align":"left","size":"normal","eyebrow":""}},{"type":"Text","props":{"id":"workshops-text-10","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Every workshop follows the same easy rhythm, so you can come on your own and feel at home."}]}]},"align":"left","tone":"muted","placeholder":["text"]}}],"column2":[{"type":"IconList","props":{"id":"workshops-iconlist-11","icon":"numbers","numberStyle":"circle","iconColor":"primary","items":[{"text":"9:30. Coffee and a pastry while everyone arrives."},{"text":"10:00. A short demonstration, then hands on."},{"text":"12:00. A break at the counter, with bread from the morning bake."},{"text":"13:00. Finish, tidy up and take your work home, or leave it for the kiln."}],"placeholder":["items"]}}],"column3":[],"column4":[],"widths":{"desktop":"one-two","tablet":"one-two","phone":"stack"}}}]}},{"type":"Section","props":{"id":"workshops-section-17","background":"background","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"workshops-columns-16","count":"2","gap":"xl","column1":[{"type":"Heading","props":{"id":"workshops-heading-14","text":"Questions","level":"h2","align":"left","size":"normal","eyebrow":""}}],"column2":[{"type":"Accordion","props":{"id":"workshops-accordion-15","firstOpen":"yes","oneAtATime":"no","items":[{"question":"Do I need any experience?","answer":"None at all. Most people at the wheel have never touched clay before."},{"question":"Can I book for a group?","answer":"Yes. Eight people can book the whole back room on a Saturday afternoon. Write to us for a date."},{"question":"What if I can't come?","answer":"Tell us a week before and we'll move you to another Saturday or give you a refund."},{"question":"Are children welcome?","answer":"From twelve, with an adult who books a place too."}],"placeholder":["items"]}}],"column3":[],"column4":[],"widths":{"desktop":"one-two","tablet":"one-two","phone":"stack"}}}]}},{"type":"LinkedSection","props":{"id":"workshops-linkedsection-18","section":"contact-strip"}}]}},{"path":"/about","title":"Our story","description":"How a bakery that stood empty for ten years became Corner Workshop: the oven, the people and the back room.","puck":{"root":{"props":{}},"content":[{"type":"Section","props":{"id":"about-section-5","background":"surface","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"about-columns-4","count":"2","gap":"xl","column1":[{"type":"Heading","props":{"id":"about-heading-1","text":"A bakery, a coffee bar and a back room full of tools","level":"h1","align":"left","size":"display","eyebrow":"Our story","placeholder":["text","eyebrow"]}},{"type":"Text","props":{"id":"about-text-2","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Corner is eleven people, one old oven and a long table where strangers end up sharing a pot of coffee."}]}]},"align":"left","tone":"muted","placeholder":["text"]}}],"column2":[{"type":"Image","props":{"id":"about-image-3","src":"/media/carnations.jpg","alt":"Pink and orange carnations wrapped in brown paper on white linen","caption":"","placeholder":["src"]}}],"column3":[],"column4":[],"widths":{"desktop":"equal","tablet":"equal","phone":"stack"},"valign":"middle"}}]}},{"type":"Section","props":{"id":"about-section-8","background":"background","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","width":"narrow","content":[{"type":"Heading","props":{"id":"about-heading-6","text":"How it started","level":"h2","align":"left","size":"normal","eyebrow":""}},{"type":"Text","props":{"id":"about-text-7","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"In 2017 the bakery on Mill Lane had been empty for ten years. The windows were papered over, but the oven, built in 1962, was still standing in the back."}]},{"type":"p","children":[{"text":"We cleaned it, fired it, and baked our first loaves for the neighbours who'd watched us working through the window. They came back the next day, and the day after. The back room, where the flour used to be stored, became a workshop a year later."}]}]},"align":"left","tone":"muted","placeholder":["text"]}}]}},{"type":"Section","props":{"id":"about-section-10","background":"background","paddingY":"md","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Stats","props":{"id":"about-stats-9","look":"lines","size":"md","colour":"primary","align":"left","items":[{"value":"1962","label":"the year our oven was built","detail":""},{"value":"48 hours","label":"every sourdough rests","detail":""},{"value":"6 days","label":"a week, Tuesday to Sunday","detail":""},{"value":"11","label":"people in the kitchen, counter and workshop","detail":""}],"placeholder":["items"]}}]}},{"type":"Section","props":{"id":"about-section-16","background":"surface","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"about-columns-15","count":"2","gap":"xl","column1":[{"type":"Image","props":{"id":"about-image-11","src":"/media/tool-wall.jpg","alt":"A workshop wall of chisels, saws and hand planes in neat rows","caption":"","placeholder":["src"]}}],"column2":[{"type":"Heading","props":{"id":"about-heading-12","text":"The back room","level":"h2","align":"left","size":"normal","eyebrow":"Workshop","placeholder":["text","eyebrow"]}},{"type":"Text","props":{"id":"about-text-13","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Every tool on this wall was bought second-hand, sharpened and given a place. On Saturdays it's a classroom; the rest of the week our potter and our carpenter make the cups and shelves you'll find in the shop."}]}]},"align":"left","tone":"muted","placeholder":["text"]}},{"type":"Text","props":{"id":"about-text-14","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"See the workshops","href":"/workshops"}]}]},"align":"left","tone":"default"}}],"column3":[],"column4":[],"widths":{"desktop":"equal","tablet":"equal","phone":"stack"},"valign":"middle"}}]}},{"type":"Section","props":{"id":"about-section-18","background":"background","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","width":"narrow","content":[{"type":"Quote","props":{"id":"about-quote-17","text":"They didn't just open a bakery. They gave the street a place to meet again.","name":"Niamh Walsh","role":"Owner of the flower stall next door","imageSrc":"","align":"center","size":"large","placeholder":["text","name","role"]}}]}},{"type":"LinkedSection","props":{"id":"about-linkedsection-19","section":"contact-strip"}}]}},{"path":"/visit","title":"Visit us","description":"Corner Workshop is at 14 Mill Lane, Dublin 8. Opening hours, how to get here and how to order ahead.","puck":{"root":{"props":{}},"content":[{"type":"Section","props":{"id":"visit-section-7","background":"background","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"visit-columns-6","count":"2","gap":"xl","column1":[{"type":"Heading","props":{"id":"visit-heading-1","text":"14 Mill Lane, Dublin 8","level":"h1","align":"left","size":"display","eyebrow":"Visit us","placeholder":["text","eyebrow"]}},{"type":"Text","props":{"id":"visit-text-2","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Five minutes' walk from the canal, next to the flower stall. Buses 13 and 40 stop at the end of the lane, and there's a bike rack by the door."}]}]},"align":"left","tone":"muted","placeholder":["text"]}},{"type":"Table","props":{"id":"visit-table-3","caption":"Opening hours","rows":[["Day","Open"],["Tuesday to Friday","7:00 to 17:00"],["Saturday","8:00 to 16:00"],["Sunday","8:00 to 13:00"],["Monday","Closed"]],"headers":"both","look":"lines","placeholder":["caption","rows"]}},{"type":"IconList","props":{"id":"visit-iconlist-4","icon":"check","iconColor":"primary","items":[{"text":"+353 1 555 0187","icon":"phone"},{"text":"hello@corner.example","icon":"mail"}],"placeholder":["items"]}}],"column2":[{"type":"Image","props":{"id":"visit-image-5","src":"/media/flower-shop.jpg","alt":"A small flower shop front with buckets of flowers and wooden crates on the pavement","caption":"","placeholder":["src"]}}],"column3":[],"column4":[],"widths":{"desktop":"equal","tablet":"equal","phone":"stack"},"valign":"middle"}}]}},{"type":"Section","props":{"id":"visit-section-12","background":"surface","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"visit-columns-11","count":"2","gap":"xl","column1":[{"type":"Heading","props":{"id":"visit-heading-8","text":"Order ahead","level":"h2","align":"left","size":"normal","eyebrow":""}},{"type":"Text","props":{"id":"visit-text-9","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Cakes, bread for a party or coffee for an office: tell us by Thursday for the weekend, and we'll have it ready at the counter."}]}]},"align":"left","tone":"muted","placeholder":["text"]}}],"column2":[{"type":"ContactForm","props":{"id":"visit-contactform-10","nameLabel":"Your name","emailLabel":"Email","messageLabel":"What would you like, and for when?","fields":[],"submitLabel":"Send order","successMessage":"Thank you. We'll confirm your order by email before the end of the day."}}],"column3":[],"column4":[],"widths":{"desktop":"equal","tablet":"equal","phone":"stack"}}}]}}]}}],"sections":[{"id":"contact-strip","name":"Order ahead strip","content":[{"type":"Section","props":{"id":"strip-section-5","background":"surface","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"strip-columns-4","count":"2","gap":"xl","column1":[{"type":"Heading","props":{"id":"strip-heading-1","text":"Ordering for a party? Tell us by Thursday.","level":"h2","align":"left","size":"normal","eyebrow":"","placeholder":["text"]}}],"column2":[{"type":"Text","props":{"id":"strip-text-2","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Cakes, bread and coffee for ten or a hundred, ready at the counter on the day."}]}]},"align":"left","tone":"default","placeholder":["text"]}},{"type":"Button","props":{"id":"strip-button-3","label":"Order ahead","href":"/visit","variant":"primary","align":"left"}}],"column3":[],"column4":[],"widths":{"desktop":"two-one","tablet":"two-one","phone":"stack"},"valign":"bottom"}}]}}]}],"layouts":[],"blog":{"title":"News","intro":"New bakes, workshop dates and what's happening on Mill Lane."},"posts":[{"slug":"why-sourdough-rests","title":"Why our sourdough rests for 48 hours","description":"Two days from flour to loaf sounds slow. Here's what happens in that time, and why you can taste it.","date":"2026-10-09","cover":"/media/loaves.jpg","coverAlt":"Dark-crusted sourdough loaves beside a vase of yellow flowers","puck":{"root":{"props":{}},"content":[{"type":"Section","props":{"id":"post-rest-section-5","background":"background","paddingY":"md","height":"auto","valign":"center","imageSrc":"","tint":"medium","width":"narrow","content":[{"type":"Text","props":{"id":"post-rest-text-1","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Most bread is made in a few hours. Ours takes two days, and people ask why every week."}]},{"type":"p","children":[{"text":"The short answer: time does what machines and additives do in a factory, only better. The flour and water are mixed on Tuesday afternoon, and the loaf you buy on Thursday morning has been slowly working ever since."}]}]},"align":"left","tone":"default","placeholder":["text"]}},{"type":"Heading","props":{"id":"post-rest-heading-2","text":"What happens in 48 hours","level":"h2","align":"left","size":"normal","eyebrow":""}},{"type":"IconList","props":{"id":"post-rest-iconlist-3","icon":"numbers","numberStyle":"plain","iconColor":"primary","items":[{"text":"Day one, afternoon: flour, water and our starter are mixed, then left alone."},{"text":"Day one, evening: we fold the dough four times, an hour apart."},{"text":"Day two: the shaped loaves rest overnight in the cold room."},{"text":"Day three, 5:00: into the oven, and on the counter by seven."}],"placeholder":["items"]}},{"type":"Text","props":{"id":"post-rest-text-4","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"The result is a crust that crackles, a crumb that stays soft for days, and bread that many people who can't eat ordinary loaves find easier to digest."}]}]},"align":"left","tone":"default","placeholder":["text"]}}]}}]}},{"slug":"spring-workshops","title":"New Saturday workshops this spring","description":"Glazing, a sourdough class and a woodwork weekend join the pottery mornings. Dates and how to book.","date":"2026-09-18","cover":"/media/ceramic-bottles.jpg","coverAlt":"Rows of glazed ceramic bottles in sage green and pale blue","puck":{"root":{"props":{}},"content":[{"type":"Section","props":{"id":"post-spring-section-4","background":"background","paddingY":"md","height":"auto","valign":"center","imageSrc":"","tint":"medium","width":"narrow","content":[{"type":"Text","props":{"id":"post-spring-text-1","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"The pottery mornings have been full since the spring, so we're adding three more workshops on Saturdays."}]},{"type":"p","children":[{"text":"Glaze and fire is for anyone who has made pots with us and wants to finish them. The sourdough class sends you home with a loaf and a jar of our starter. And the woodwork weekend ends with a stool you made with hand tools only."}]}]},"align":"left","tone":"default","placeholder":["text"]}},{"type":"Image","props":{"id":"post-spring-image-2","src":"/media/tool-wall.jpg","alt":"A workshop wall of chisels, saws and hand planes in neat rows","caption":"The back room, ready for the first woodwork weekend.","placeholder":["src"]}},{"type":"Text","props":{"id":"post-spring-text-3","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"Places are eight per workshop. Book at the counter or by email."}]}]},"align":"left","tone":"default","placeholder":["text"]}}]}}]}}],"media":[{"file":"bread-hands.jpg","alt":"Two hands holding a round loaf of bread in a linen cloth","width":1280,"height":960,"data":""},{"file":"carnations.jpg","alt":"Pink and orange carnations wrapped in brown paper on white linen","width":1280,"height":1600,"data":""},{"file":"ceramic-bottles.jpg","alt":"Rows of glazed ceramic bottles in sage green and pale blue","width":1920,"height":1280,"data":""},{"file":"flower-shop.jpg","alt":"A small flower shop front with buckets of flowers and wooden crates on the pavement","width":1920,"height":1280,"data":""},{"file":"lemon-loaf.jpg","alt":"An iced lemon and lavender loaf on a cooling rack, with lemons beside it","width":1920,"height":1280,"data":""},{"file":"loaves.jpg","alt":"Dark-crusted sourdough loaves beside a vase of yellow flowers","width":1920,"height":1280,"data":""},{"file":"moka-breakfast.jpg","alt":"A moka pot, croissants and a bag of coffee on a wooden table, seen from above","width":1920,"height":1280,"data":""},{"file":"moka-pour.jpg","alt":"Coffee pouring from a moka pot into a blue-striped cup","width":1920,"height":1280,"data":""},{"file":"pottery-wheel.jpg","alt":"Hands shaping wet clay on a turning pottery wheel, seen from above","width":1920,"height":1280,"data":""},{"file":"pouring-coffee.jpg","alt":"Coffee poured from a small jug into a white cup on a worn wooden counter","width":1280,"height":1600,"data":""},{"file":"tool-wall.jpg","alt":"A workshop wall of chisels, saws and hand planes in neat rows","width":1920,"height":1280,"data":""}],"designs":[{"kind":"post","content":[{"type":"Section","props":{"id":"design-section-6","background":"surface","paddingY":"lg","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"Columns","props":{"id":"design-columns-5","count":"2","gap":"xl","column1":[{"type":"PostDetails","props":{"id":"design-postdetails-1","show":"both","align":"left"}},{"type":"PostTitle","props":{"id":"design-posttitle-2","size":"display","align":"left"}},{"type":"PostSummary","props":{"id":"design-postsummary-3","align":"left"}}],"column2":[{"type":"PostCover","props":{"id":"design-postcover-4","ratio":"square"}}],"column3":[],"column4":[],"widths":{"desktop":"equal","tablet":"equal","phone":"stack"},"valign":"middle"}}]}},{"type":"PostContent","props":{"id":"design-postcontent-7"}},{"type":"LinkedSection","props":{"id":"design-linkedsection-8","section":"contact-strip"}}]},{"kind":"blog","content":[{"type":"Section","props":{"id":"design-section-12","background":"background","paddingY":"xl","height":"auto","valign":"center","imageSrc":"","tint":"medium","content":[{"type":"BlogTitle","props":{"id":"design-blogtitle-9","size":"display","align":"left"}},{"type":"BlogIntro","props":{"id":"design-blogintro-10","align":"left"}},{"type":"PostList","props":{"id":"design-postlist-11","look":"cards","columns":"auto","count":"all","photo":"yes","date":"yes","summary":"yes","titleLevel":"h2"}}]}}]},{"kind":"notFound","title":"Page not found","content":[{"type":"Section","props":{"id":"design-section-18","background":"surface","paddingY":"xl","height":"medium","valign":"center","imageSrc":"","tint":"medium","width":"narrow","content":[{"type":"Heading","props":{"id":"design-heading-13","text":"This shelf is empty","level":"h1","align":"center","size":"display","eyebrow":"Page not found"}},{"type":"Text","props":{"id":"design-text-14","text":{"rich":1,"blocks":[{"type":"p","children":[{"text":"The page you were looking for has moved or sold out. Today's menu is still on the counter."}]}]},"align":"center","tone":"muted"}},{"type":"Spacer","props":{"id":"design-spacer-15","size":"sm"}},{"type":"Button","props":{"id":"design-button-16","label":"See today's menu","href":"/menu","variant":"primary","align":"center"}},{"type":"Button","props":{"id":"design-button-17","label":"Go to the home page","href":"/","variant":"arrow","align":"center"}}]}}]}]}
