{
  "name": "crust",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @crust/admin",
    "build": "npm run build -w @crust/admin",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "render": "tsx packages/render/src/cli.ts content dist/site",
    "publish:local": "npm run render && cargo run -q -p crust-publish -- dist/site --base-url https://example.pages.dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
