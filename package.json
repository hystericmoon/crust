{
  "name": "crust",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @crust/admin",
    "build": "npm run build -w @crust/admin",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:workflows": "docker run --rm -v \"$PWD:/repo\" --workdir /repo rhysd/actionlint:1.7.7 -color",
    "render": "tsx packages/render/src/cli.ts content dist/site",
    "publish:local": "npm run render && cargo run -q -p crust-publish -- dist/site --base-url https://example.pages.dev --redirects content/redirects.json --media content/media --photo-cache .crust-cache/photos --fonts packages/blocks/fonts && pagefind --site dist/site --silent",
    "check:a11y": "npm run publish:local && node scripts/check-a11y.mjs && npm run -s check:layouts && npm run -s check:builder",
    "check:perf": "npm run publish:local && node scripts/check-perf.mjs",
    "check:layouts": "tsx packages/render/src/layouts-cli.ts content dist/layout-check && node scripts/check-a11y.mjs dist/layout-check",
    "check:builder": "node scripts/check-builder-a11y.mjs",
    "check:template": "tsx scripts/check-template.ts",
    "build:starters": "tsx scripts/starter-templates/build.ts",
    "gen:responsive-css": "tsx scripts/responsive-css.ts",
    "desktop:dev": "cd crates/crust-desktop && tauri dev",
    "desktop:build": "cd crates/crust-desktop && tauri build",
    "fonts:sync": "tsx scripts/fonts/sync.ts"
  },
  "devDependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "happy-dom": "^20.14.6",
    "lighthouse": "^13.5.0",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
